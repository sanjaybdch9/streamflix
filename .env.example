# Copy to .env and replace every value. Generate secrets with:  openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
PLAYBACK_SECRET=change-me-playback-secret
# Letters and digits only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changemepostgres
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Comma-separated emails that get the admin role on sign-up (can add titles via POST /api/catalog/titles).
ADMIN_EMAILS=
